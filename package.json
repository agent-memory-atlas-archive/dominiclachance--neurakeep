{
  "name": "neurakeep",
  "version": "0.0.1",
  "description": "NeuraKeep: local-first, source-cited memory for AI agents.",
  "type": "module",
  "bin": {
    "umos": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:web": "vite build",
    "build:all": "npm run build && npm run build:web",
    "dev": "tsx src/cli/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5176",
    "e2e": "npm run build:all && node dist/cli/index.js init --root .umos && node dist/cli/index.js app --root .umos && playwright test",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "memory",
    "mcp",
    "llm",
    "agents",
    "markdown",
    "sqlite"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "commander": "^14.0.2",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.0.14"
  }
}
